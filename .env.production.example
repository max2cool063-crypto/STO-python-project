# Production template. Copy to your deployment secret store or .env.production
# and replace every placeholder before deployment. Never commit real secrets.

# Django
SECRET_KEY=replace-with-a-long-random-production-secret-at-least-50-characters
DEBUG=False
ALLOWED_HOSTS=example.com,www.example.com
CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com

# HTTPS hardening
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
# Enable only when every subdomain is permanently HTTPS.
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
# Enable only after deliberately opting the domain into HSTS preload requirements.
SECURE_HSTS_PRELOAD=False
SECURE_REFERRER_POLICY=same-origin
# Set True only when TLS terminates at a trusted reverse proxy that sets
# X-Forwarded-Proto correctly. Otherwise leave False.
SECURE_PROXY_SSL_HEADER=False

# Auth rate limiting
# Keep forwarded-for trust disabled unless every request reaches Django through
# a trusted proxy and RATE_LIMIT_TRUSTED_PROXIES lists only those proxy networks.
RATE_LIMIT_TRUST_X_FORWARDED_FOR=False
RATE_LIMIT_TRUSTED_PROXIES=

# PostgreSQL
POSTGRES_DB=sto
POSTGRES_USER=sto
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis. Docker Compose overrides this with redis://redis:6379/1.
REDIS_URL=

# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=notifications@example.com
EMAIL_HOST_PASSWORD=replace-with-an-app-password

# Yandex Maps
YANDEX_MAPS_API_KEY=replace-with-your-api-key
