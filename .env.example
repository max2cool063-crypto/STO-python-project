# Скопируйте этот файл в .env и заполните значения

# Django
SECRET_KEY=замените-на-длинную-случайную-строку
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com
CSRF_TRUSTED_ORIGINS=https://yourdomain.com

# Production HTTPS hardening
# Для локального Docker HTTP оставьте False.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
SECURE_REFERRER_POLICY=same-origin
# Включайте только если приложение стоит за вашим reverse proxy,
# который корректно устанавливает X-Forwarded-Proto.
SECURE_PROXY_SSL_HEADER=False

# Auth rate limiting
# В Docker Compose Redis URL задаётся автоматически.
# Для reverse proxy X-Forwarded-For оставляйте False, пока не укажете
# доверенные IP/сети прокси в RATE_LIMIT_TRUSTED_PROXIES.
RATE_LIMIT_TRUST_X_FORWARDED_FOR=False
RATE_LIMIT_TRUSTED_PROXIES=

# База данных
POSTGRES_DB=sto
POSTGRES_USER=sto
POSTGRES_PASSWORD=замените-на-надёжный-пароль
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis (для локального запуска вне Docker можно указать, например,
# redis://127.0.0.1:6379/1; в Docker значение задаётся compose-файлом.)
REDIS_URL=

# Email (Gmail App Password)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your@gmail.com
EMAIL_HOST_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Яндекс Карты
YANDEX_MAPS_API_KEY=ваш-ключ
